{
  "name": "@dayflow/blossom-color-picker",
  "version": "2.3.0",
  "description": "A beautiful, blooming color picker — standalone vanilla JS",
  "keywords": [
    "animation",
    "blossom",
    "color-picker",
    "ui-component",
    "vanilla-js"
  ],
  "license": "MIT",
  "author": "Jayce Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayflow-js/BlossomColorPicker.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  }
}
