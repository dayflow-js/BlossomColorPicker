{
  "name": "blossom-color-picker-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A beautiful, blooming color picker for Web",
  "homepage": "https://github.com/dayflow-js/BlossomColorPicker#readme",
  "bugs": {
    "url": "https://github.com/dayflow-js/BlossomColorPicker/issues"
  },
  "license": "MIT",
  "author": "Jayce Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayflow-js/BlossomColorPicker.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "bump:all": "./scripts/bump_all.sh",
    "dev": "pnpm --filter website dev --port 5177",
    "dev:demo": "vite --host --port 5177",
    "dev:packages": "pnpm --filter './packages/**' --parallel dev",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "predev": "pnpm --filter @dayflow/blossom-color-picker-react... build",
    "prepare": "lefthook install",
    "publish:all": "./scripts/publish.sh all",
    "publish:angular": "./scripts/publish.sh angular",
    "publish:dry": "./scripts/publish.sh all --dry-run",
    "publish:main": "./scripts/publish.sh main",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@10.34.5"
}
